<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{% if cim %}{{ cim }} – {{ beallitasok.nev }}{% else %}{{ beallitasok.nev }} – házias napi menü Óbudán{% endif %}</title>
    <meta name="description" content="{{ leiras | default('Napi friss alapanyagokból főzött házias menü a Szentendrei úton. Heti menü elvitelre és helyben fogyasztásra.') }}" />
    <link rel="canonical" href="{{ page.url | abszolutUrl(beallitasok.url) }}" />

    <meta property="og:type" content="{{ ogTipus | default('website') }}" />
    <meta property="og:site_name" content="{{ beallitasok.nev }}" />
    <meta property="og:title" content="{% if cim %}{{ cim }} – {{ beallitasok.nev }}{% else %}{{ beallitasok.nev }}{% endif %}" />
    <meta property="og:description" content="{{ leiras | default('Napi friss alapanyagokból főzött házias menü a Szentendrei úton.') }}" />
    <meta property="og:url" content="{{ page.url | abszolutUrl(beallitasok.url) }}" />
    <meta property="og:image" content="{{ ('/assets/img/' + (borito | default('csirke-bulgur.webp'))) | abszolutUrl(beallitasok.url) }}" />
    <meta property="og:locale" content="hu_HU" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#1e4245" />
    {# A 32 pixeles ikon 3 kB, a 180 pixeles 70 – böngésző-fülre az előbbi is elég,
       a nagyot csak az iOS kéri le, ha valaki a kezdőképernyőre teszi az oldalt. #}
    <link rel="icon" href="/assets/img/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/img/favicon.png" />
    <link rel="alternate" type="application/atom+xml" title="{{ beallitasok.nev }} – blog" href="/feed.xml" />

    {# A betűtípus a CSS-ből csak a stíluslap letöltése UTÁN indulna el; így a
       két szelet a HTML-lel együtt jön, és nem villan bele a tartalék betű. #}
    <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/bitter-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/bitter-latin-ext.woff2" crossorigin />
    {% if elotoltottKep %}<link rel="preload" as="image" href="{{ elotoltottKep }}" fetchpriority="high" />{% endif %}
    <link rel="stylesheet" href="/assets/css/style.css" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#tartalom"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-paradicsom-600 focus:px-5 focus:py-3 focus:text-white"
      >Ugrás a tartalomra</a
    >

    {% include "reszek/fejlec.njk" %}

    {# Akció-sáv: a Beállítások „akcio” mezőjéből jön; amíg a mező üres, a sáv
       el sem készül. A vörös a márka-szabály szerint csak accent — itt a jelvény. #}
    {% if beallitasok.akcio %}
      <aside class="border-b border-pergamen-300 bg-pergamen-100">
        <div class="szakasz flex flex-wrap items-center justify-center gap-x-4 gap-y-2 py-3 text-center">
          <p class="rounded-full bg-paradicsom-600 px-3 py-1 text-sm font-semibold uppercase tracking-[0.18em] text-white">Akció</p>
          <p class="font-display text-lg font-bold text-petrol-800">{{ beallitasok.akcio }}</p>
        </div>
      </aside>
    {% endif %}

    <main id="tartalom" class="flex-1">{{ content | safe }}</main>

    {% include "reszek/lablec.njk" %}

    {# Szervezet-adatok a keresőknek — minden oldalon #}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Restaurant",
        "@id": "{{ beallitasok.url }}/#kifozde",
        "name": "{{ beallitasok.nev }}",
        "url": "{{ beallitasok.url }}/",
        "image": "{{ beallitasok.url }}/assets/img/csirke-bulgur.webp",
        "logo": "{{ beallitasok.url }}/assets/img/logo.webp",
        "servesCuisine": ["Magyar", "Házias", "Nemzetközi"],
        "priceRange": "$",
        "currenciesAccepted": "HUF",
        "paymentAccepted": "Készpénz, bankkártya",
        "hasMenu": "{{ beallitasok.url }}/heti-menu/",
        {%- set profilok = [] %}
        {%- if beallitasok.wolt %}{% set profilok = (profilok.push(beallitasok.wolt), profilok) %}{% endif %}
        {%- if beallitasok.facebook %}{% set profilok = (profilok.push(beallitasok.facebook), profilok) %}{% endif %}
        {%- if beallitasok.google.url %}{% set profilok = (profilok.push(beallitasok.google.url), profilok) %}{% endif %}
        {%- if profilok.length %}"sameAs": {{ profilok | dump | safe }},{% endif %}
        "telephone": "{{ beallitasok.telefon }}",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "{{ beallitasok.cim.utca }}",
          "addressLocality": "{{ beallitasok.cim.varos }}",
          "postalCode": "{{ beallitasok.cim.iranyitoszam }}",
          "addressCountry": "HU"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": {{ beallitasok.cim.szelesseg }},
          "longitude": {{ beallitasok.cim.hosszusag }}
        },
        {# A nyitvatartás a beallitasok.json `nyitvatartas_gepi` mezőjéből jön,
           nem kézzel írva ide — így nem tud elcsúszni attól, ami az oldalon
           látszik. A keresők (Google találati oldal) ezt olvassák. #}
        "openingHoursSpecification": [
          {%- for ny in beallitasok.nyitvatartas_gepi %}
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": {{ ny.napok | dump | safe }},
            "opens": "{{ ny.nyit }}",
            "closes": "{{ ny.zar }}"
          }{{ "," if not loop.last }}
          {%- endfor %}
        ]
      }
    </script>
    {% if strukturaltAdat %}<script type="application/ld+json">{{ strukturaltAdat | safe }}</script>{% endif %}

    <script src="/assets/js/oldal.js" defer></script>
  </body>
</html>
