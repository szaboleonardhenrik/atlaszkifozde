---
layout: base.njk
ogTipus: article
---

<article>
  <header class="relative overflow-hidden bg-pergamen-100 py-12 md:py-16">
    {% include "reszek/fejdisz.njk" %}
    <div class="szakasz relative mx-auto max-w-3xl text-center">
      <p class="cimke">Blog</p>
      <h1 class="mt-5 font-display text-3xl font-bold leading-tight sm:text-4xl lg:text-5xl">{{ cim }}</h1>
      <p class="mt-5 text-petrol-900/60">
        <time datetime="{{ page.date | isoDatum }}">{{ page.date | magyarDatum }}</time>
        {% if szerzo %} · {{ szerzo }}{% endif %}
      </p>
    </div>
  </header>

  {% if borito %}
    {% set boritoKicsi = borito | kicsi %}
    {% set nagySzel = ('/assets/img/' + borito) | kepSzeles %}
    {% set kicsiSzel = ('/assets/img/' + boritoKicsi) | kepSzeles %}
    <div class="szakasz -mt-6 md:-mt-10">
      {# A kép legfeljebb 896 képpont szélesen látszik; telefonon ennél jóval
         keskenyebben, ezért ott a kicsinyített változat megy le. #}
      <img
        src="/assets/img/{{ borito }}"
        {% if nagySzel and kicsiSzel and boritoKicsi != borito %}
          srcset="/assets/img/{{ boritoKicsi }} {{ kicsiSzel }}w, /assets/img/{{ borito }} {{ nagySzel }}w"
          sizes="(max-width: 896px) 100vw, 896px"
        {% endif %}
        alt="{{ boritoLeiras | default('') }}"
        fetchpriority="high"
        class="mx-auto w-full max-w-4xl rounded-3xl object-cover shadow-lg"
      />
    </div>
  {% endif %}

  <div class="szakasz py-12 md:py-16">
    <div class="szoveg mx-auto max-w-3xl">
      {{ content | safe }}
    </div>

    <div class="mx-auto mt-14 max-w-3xl border-t border-pergamen-300 pt-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <a class="font-semibold text-paradicsom-600 hover:underline" href="/blog/">← Vissza a blogra</a>
        <a class="gomb gomb-elsodleges" href="/heti-menu/">E heti menü</a>
      </div>
    </div>

    {% set ajanlo = collections.bejegyzesek | kapcsolodo(page.url, 3) %}
    {% if ajanlo.length %}
      <aside class="mx-auto mt-14 max-w-5xl border-t border-pergamen-300 pt-10">
        <h2 class="text-center font-display text-2xl font-bold">Ezt is olvasd el</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {% for b in ajanlo %}
            <article class="flex flex-col overflow-hidden rounded-2xl border border-pergamen-300 bg-white shadow-sm">
              {% if b.data.borito %}
                <a href="{{ b.url }}" tabindex="-1" aria-hidden="true">
                  <img src="/assets/img/{{ b.data.borito | kicsi }}" alt="" loading="lazy" class="h-36 w-full object-cover" />
                </a>
              {% endif %}
              <div class="flex flex-1 flex-col p-5">
                <time class="text-sm text-petrol-900/60" datetime="{{ b.date | isoDatum }}">{{ b.date | magyarDatum }}</time>
                <h3 class="mt-2 font-bold leading-snug">
                  <a class="hover:text-paradicsom-600" href="{{ b.url }}">{{ b.data.cim }}</a>
                </h3>
              </div>
            </article>
          {% endfor %}
        </div>
      </aside>
    {% endif %}
  </div>
</article>

{# A cikk-adatok itt, a törzsben szerepelnek: a sablonban `set`-tel beállított
   változó nem jutna el a szülő elrendezésbe (base.njk), a JSON-LD viszont a
   dokumentum bármely pontján állhat. #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ cim | dump | safe }},
  "description": {{ leiras | default("") | dump | safe }},
  "datePublished": "{{ page.date | isoDatum }}",
  "dateModified": "{{ page.date | isoDatum }}",
  "inLanguage": "hu-HU",
  "image": "{{ beallitasok.url }}/assets/img/{{ borito | default('csirke-bulgur.webp') }}",
  "author": { "@type": "Organization", "name": {{ beallitasok.nev | dump | safe }} },
  "publisher": {
    "@type": "Organization",
    "name": {{ beallitasok.nev | dump | safe }},
    "logo": { "@type": "ImageObject", "url": "{{ beallitasok.url }}/assets/img/logo.webp" }
  },
  "mainEntityOfPage": "{{ page.url | abszolutUrl(beallitasok.url) }}"
}
</script>

{# Morzsamenü: a keresőtalálat alatt a puszta URL helyett az útvonal látszik. #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Főoldal", "item": "{{ '/' | abszolutUrl(beallitasok.url) }}" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "{{ '/blog/' | abszolutUrl(beallitasok.url) }}" },
    { "@type": "ListItem", "position": 3, "name": {{ cim | dump | safe }} }
  ]
}
</script>
