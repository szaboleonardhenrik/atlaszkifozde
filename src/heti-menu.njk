---
layout: base.njk
permalink: /heti-menu/
cim: Heti menü
leiras: "Az Atlasz Kifőzde aktuális heti menüje: leves és főétel minden napra 2290 Ft-ért, egész hetes befizetéssel 2100 Ft/nap. Elvitelre és helyben."
borito: pult.webp
---

{% set aktualis = menu.hetek | aktualisHet %}
{% set lathatoHetek = menu.hetek | jovobeliHetek %}

<section class="bg-pergamen-100 py-12 md:py-16">
  <div class="szakasz text-center">
    <p class="cimke">Minden hétfőn új</p>
    <h1 class="cim-disz mt-4 font-display text-4xl font-bold sm:text-5xl">Heti menü</h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-petrol-900/75">
      A menü minden hétfőn frissen indul, változatos, házias fogásokkal. Az
      ételeket mindig friss alapanyagokból készítjük, és igyekszünk hét közben is
      elhozni a családias, otthonos ízeket. Elvitelre és helyben fogyasztásra
      egyaránt.
    </p>
  </div>
</section>

<section class="szakasz py-12 md:py-16">
  {% for h in lathatoHetek %}
    <div class="{% if not loop.first %}mt-8{% endif %}">
      {% set het = h %}
      {# Kettőnél több hét is fent lehet (pl. egy közbeeső zárva hét miatt),
         ilyenkor a harmadiktól „Későbbi hét” – a pontos dátum a kártya fejlécében van. #}
      {% if h.kezdes == aktualis.kezdes %}
        {% set cimke = "E heti menü" %}
      {% elif loop.index0 == 1 %}
        {% set cimke = "Következő hét" %}
      {% else %}
        {% set cimke = "Későbbi hét" %}
      {% endif %}
      {% include "reszek/hetkartya.njk" %}
    </div>
  {% else %}
    <div class="kartya text-center">
      <p class="text-petrol-900/70">A heti menü hamarosan frissül.</p>
      <p class="mt-2">
        Addig is hívjon minket:
        <a class="font-semibold text-paradicsom-600 hover:underline" href="tel:{{ beallitasok.telefon_link }}">{{ beallitasok.telefon }}</a>
      </p>
    </div>
  {% endfor %}

  <!-- Árak -->
  <div class="mt-12 grid gap-6 md:grid-cols-2">
    <div class="kartya text-center">
      <p class="text-sm uppercase tracking-widest text-petrol-900/50">Napi menü</p>
      <p class="mt-2 font-display text-4xl font-bold text-petrol-800">{{ menu.arak.napi_menu | forint }}</p>
      <p class="mt-3 text-petrol-900/75">Leves és főétel, egy adag – bármelyik nap.</p>
    </div>
    <div class="kartya border-paradicsom-300 bg-paradicsom-100/60 text-center">
      <p class="text-sm uppercase tracking-widest text-paradicsom-700">Egész heti befizetéssel</p>
      <p class="mt-2 font-display text-4xl font-bold text-paradicsom-600">{{ menu.arak.heti_befizetes | forint }} / nap</p>
      <p class="mt-3 text-petrol-900/75">Ha a teljes hetet előre rendezi, kedvezőbb a napi ár.</p>
    </div>
  </div>
  {% if menu.arak.megjegyzes %}
    <p class="mt-4 text-center text-sm text-petrol-900/60">{{ menu.arak.megjegyzes }}</p>
  {% endif %}

  {% if beallitasok.extrak.length %}
    <div class="mt-12 rounded-3xl border border-pergamen-300 bg-pergamen-100 p-8 md:p-10">
      <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <h2 class="font-display text-2xl font-bold sm:text-3xl">A napi menü mellett</h2>
          <p class="mt-3 text-petrol-900/75">
            A pultban a leves és a főétel mellett általában ezek is megtalálhatók:
          </p>
          <ul class="mt-5 flex flex-wrap gap-3">
            {% for e in beallitasok.extrak %}
              <li class="rounded-full border border-bronz-300 bg-bronz-50 px-4 py-2 font-semibold text-bronz-700">{{ e }}</li>
            {% endfor %}
          </ul>
          <p class="mt-5 text-sm text-petrol-900/60">
            A kínálat naponta változik – ha valamire kifejezetten vágyik, érdemes telefonon rákérdezni.
          </p>
        </div>
        {% if beallitasok.wolt %}
          <a class="gomb gomb-masodlagos shrink-0" href="{{ beallitasok.wolt }}" target="_blank" rel="noopener">Aktuális kínálat a Wolton</a>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <div class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="kartya">
      <h2 class="text-xl font-bold">Elvitelre is</h2>
      <p class="mt-3 text-petrol-900/75">
        A menüt dobozban is elviheti – szóljon telefonon, és időre elkészítjük.
      </p>
    </div>
    <div class="kartya">
      <h2 class="text-xl font-bold">Céges ebéd</h2>
      <p class="mt-3 text-petrol-900/75">
        Több adagot vagy rendszeres heti ebédet is vállalunk. Egyeztessünk
        telefonon a részletekről.
      </p>
    </div>
    <div class="kartya">
      <h2 class="text-xl font-bold">Allergia, kérések</h2>
      <p class="mt-3 text-petrol-900/75">
        Ha van érzékenysége vagy kérése, hívjon minket – amiben tudunk, segítünk.
      </p>
    </div>
  </div>

  <div class="mt-12 flex flex-wrap justify-center gap-3">
    <a class="gomb gomb-elsodleges" href="tel:{{ beallitasok.telefon_link }}">Rendelés telefonon: {{ beallitasok.telefon }}</a>
    {% if beallitasok.wolt %}
      <a class="gomb gomb-masodlagos" href="{{ beallitasok.wolt }}" target="_blank" rel="noopener">Kérem házhoz – Wolt</a>
    {% endif %}
  </div>
</section>

{% include "reszek/hirlevel.njk" %}

{# A heti menü étlapként a keresőknek. Egy tétel = egy nap teljes menüje
   (leves + főétel), mert az az ár, amit a vendég fizet — a leves külön nem
   kapható, így külön MenuItem-ként félrevezető ár kerülne rá.
   A zárva napok (nincs `ar` a menu.json-ben) kimaradnak: „Zárva” néven,
   2290 Ft-os ajánlattal félrevezető étel-tétel kerülne a keresőbe. #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Menu",
  "name": "Heti menü – {{ beallitasok.nev }}",
  "url": "{{ '/heti-menu/' | abszolutUrl(beallitasok.url) }}",
  "inLanguage": "hu-HU",
  "hasMenuSection": [
    {%- for h in lathatoHetek | nyitottHetek %}
    {
      "@type": "MenuSection",
      "name": {{ (h.kezdes | hetIdoszak) | dump | safe }},
      "hasMenuItem": [
        {%- for n in h.napok | selectattr("ar") %}
        {
          "@type": "MenuItem",
          "name": {{ (n.nap + ": " + n.foetel) | dump | safe }},
          {% if n.leves %}"description": {{ ("Leves: " + n.leves) | dump | safe }},{% endif %}
          "offers": {
            "@type": "Offer",
            "price": {{ n.ar | default(menu.arak.napi_menu) }},
            "priceCurrency": "HUF"
          }
        }{{ "," if not loop.last }}
        {%- endfor %}
      ]
    }{{ "," if not loop.last }}
    {%- endfor %}
  ]
}
</script>
